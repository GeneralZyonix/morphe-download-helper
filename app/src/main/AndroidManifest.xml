<?xml version="1.0" encoding="utf-8"?>
<!--
    Morphe Download Helper
    Unofficial third-party helper for Morphe Manager.
    This manifest declares the intent contract Morphe uses to request an APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to search APKMirror/APKPure and download the APK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Used to read the installed app's versionCode when Morphe omits it. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Keep long downloads alive while the helper is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-sdk tools:overrideLibrary="rikka.shizuku.api,rikka.shizuku.provider" />

    <!--
        Android 11+ package visibility: without this block the app cannot see whether
        Morphe is installed or open its launcher activity.
    -->
    <queries>
        <package android:name="app.morphe.manager" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Launcher screen: instructions, source list, log actions, uninstall. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- In-app visual setup guide. -->
        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:label="@string/main_visual_guide" />

        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:label="@string/common_update" />

        <!-- Source settings: choose which APK sources the helper may use. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/common_settings" />

        <!--
            Helper contract: Morphe sends this action when the user taps
            "Use a helper app". The activity returns a content:// URI to the APK.
        -->
        <activity
            android:name=".DownloadActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="app.morphe.manager.action.DOWNLOAD_ORIGINAL_APK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Shows download progress and keeps the process foreground while downloading. -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".UpdateReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".UpdateInstalledReceiver"
            android:exported="false" />

        <!--
            FileProvider exposes downloaded files and the log file to Morphe/other apps
            through content:// URIs. The allowed paths live in res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>






