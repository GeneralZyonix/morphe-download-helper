    <!-- Visual setup guide. -->
    <string name="guide_title">Visual setup guide</string>
    <string name="guide_intro">Enable the helper in Morphe and optionally let Morphe open it automatically.</string>
    <string name="guide_step1_title">Open Morphe Settings</string>
    <string name="guide_step1_body">Tap Settings in the bottom bar, scroll to Files, then tap APK download helper.</string>
    <string name="guide_step2_title">Trust the helper</string>
    <string name="guide_step2_body">Find Morphe Download Helper and turn on its toggle. Confirm the Trust prompt.</string>
    <string name="guide_step3_title">Optional: open it right away</string>
    <string name="guide_step3_body">Turn on Open helper right away to skip Morphe’s download instructions.</string>
    <string name="guide_step4_title">Use it while patching</string>
    <string name="guide_step4_body">Patch an app and choose Use a helper app. Wait for the download; the helper returns the APK automatically.</string>

